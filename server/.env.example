# 서버
PORT=3001
API_KEY=change-me-to-a-long-random-secret

# SQLite (포켓리스 앱과 공유 예정인 shared.db 경로)
DB_PATH=./data/shared.db

# Cloudflare R2 (S3 호환)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=oc-yeonsung
R2_PUBLIC_BASE_URL=https://img.lunayeon.com

# 마이그레이션 전용 (firestore-export.js 실행 시에만 필요)
GOOGLE_APPLICATION_CREDENTIALS=./migrate/serviceAccountKey.json
FIREBASE_STORAGE_BUCKET=oc-yeonsung.firebasestorage.app
